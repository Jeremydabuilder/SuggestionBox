# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Project Settings -> Data API  (and -> API Keys for the two keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# The two co-presidents — required
# ---------------------------------------------------------------------------
# Exactly two addresses, comma separated. They must also exist in the
# authorized_presidents table (see supabase/migrations). An address has to
# appear in BOTH places to get into /president.
PRESIDENT_EMAILS=co-president-one@school.org,co-president-two@school.org

# ---------------------------------------------------------------------------
# Site URL — required in production
# ---------------------------------------------------------------------------
# Your custom domain, no trailing slash. Used for sign-in links.
NEXT_PUBLIC_SITE_URL=https://suggestions.yourschool.org

# ---------------------------------------------------------------------------
# Bot protection — Cloudflare Turnstile (strongly recommended)
# ---------------------------------------------------------------------------
# Without TURNSTILE_SECRET_KEY the widget is skipped and a warning is logged.
# Server-side validation, sanitisation and rate limiting still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Any long random string. IP addresses are hashed with it, never stored raw.
IP_HASH_SALT=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Daily digest — optional, OFF by default
# ---------------------------------------------------------------------------
# The dashboard is the inbox. No email is ever sent per submission.
# Set DIGEST_ENABLED=true to get at most ONE summary email per day, and only
# when unread suggestions are waiting. The app works fully without any of this.
DIGEST_ENABLED=false
RESEND_API_KEY=
DIGEST_FROM_EMAIL=Suggestion Box <suggestions@yourschool.org>

# Protects /api/cron/digest. Vercel sends it automatically as a Bearer token.
# Without it, the endpoint refuses every request.
CRON_SECRET=another-long-random-string
