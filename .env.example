# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Project Settings -> Data API (the URL) and -> API Keys (the two keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# The two co-presidents
# ---------------------------------------------------------------------------
# There is no environment variable for them, on purpose.
#
# The authorized_presidents table in your Supabase project is the one list of
# co-presidents: the RLS policies read it, the app reads it, and the daily
# digest reads it. Keeping a second copy here would mean two lists that can
# drift apart — and it would put the two real addresses somewhere they do not
# need to be.
#
# Add them with supabase/maintenance/add_presidents.sql, in the Supabase SQL
# Editor. The deploy check confirms they are there without ever printing them.

# ---------------------------------------------------------------------------
# Site URL — required in production
# ---------------------------------------------------------------------------
# Your site's address, no trailing slash. Used to build sign-in links.
#
# On Render you can leave this unset at first: the app falls back to Render's
# own RENDER_EXTERNAL_URL, which is your temporary onrender.com address. Set it
# explicitly once you connect a custom domain.
#
# NOTE: NEXT_PUBLIC_* values are compiled into the build, so changing this
# needs a new deploy (Manual Deploy -> Deploy latest commit), not a restart.
NEXT_PUBLIC_SITE_URL=https://suggestions.yourschool.org

# ---------------------------------------------------------------------------
# Bot protection — Cloudflare Turnstile (strongly recommended)
# ---------------------------------------------------------------------------
# Without TURNSTILE_SECRET_KEY the widget is skipped and a warning is logged.
# Server-side validation, sanitisation and rate limiting still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Any long random string. IP addresses are hashed with it, never stored raw.
IP_HASH_SALT=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Daily digest — optional, OFF by default. Leave it off for launch.
# ---------------------------------------------------------------------------
# The dashboard is the inbox. No email is ever sent per submission.
#
# When switched on, this sends at most ONE summary a day, and only when unread
# suggestions are waiting. It needs a scheduled job to call /api/cron/digest,
# which on Render means a separate Cron Job service. Get the site working
# first; this can wait indefinitely.
DIGEST_ENABLED=false
RESEND_API_KEY=
DIGEST_FROM_EMAIL=Suggestion Box <suggestions@yourschool.org>

# Protects /api/cron/digest. Without it, the endpoint refuses every request.
CRON_SECRET=another-long-random-string
